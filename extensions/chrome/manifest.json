{
  "manifest_version": 3,
  "name": "NFD — Fast Download Accelerator",
  "version": "1.0.0",
  "description": "Intercepts Chrome downloads and routes them to NFD for maximum download speed via multi-segment parallel connections.",
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NFD Download Accelerator",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  }
}
